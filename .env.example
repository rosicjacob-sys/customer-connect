# Customer Connect settings. Copy to .env and fill in.

# ── Required ────────────────────────────────────────────────────────────────
# Its own Postgres database (not Chat Support Pro's). Tables are created on start.
DATABASE_URL=postgresql://user:password@host:5432/customer_connect
# Long random string; signs sign-in tokens. e.g. `openssl rand -hex 32`
JWT_SECRET=
# Public address of this app. Every email's unsubscribe link points here.
APP_URL=https://connect.yourdomain.com

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Without a key, development runs in dry run: emails are built but kept in the
# Settings → Outbox instead of being sent. In production set the key, or
# EMAIL_DRY_RUN=true to try the app without sending.
RESEND_API_KEY=
# EMAIL_DRY_RUN=true
# Sender for stores that don't have their own address. The domain must be verified in Resend.
DEFAULT_FROM_EMAIL=info@pepscustomercare.com
DEFAULT_FROM_NAME=Customer Support
# Pause between two emails, in ms. Resend allows 2 requests a second by default.
# SEND_DELAY_MS=550

# ── First start ─────────────────────────────────────────────────────────────
# Creates this admin when there are no users yet (ignored afterwards).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# ── Optional: link Chat Support Pro (read only) ─────────────────────────────
# Its DATABASE_URL, ideally for a read-only Postgres user. Copies its stores,
# customers (dated by their last chat), unsubscribes, blacklist and sent
# history every CHAT_SUPPORT_SYNC_MINUTES, and checks its unsubscribes and
# blacklist before every batch.
# CHAT_SUPPORT_DATABASE_URL=postgresql://readonly_user:password@host:5432/chat_support
# CHAT_SUPPORT_SYNC_MINUTES=15

# ── Optional: link the checkout portal ──────────────────────────────────────
# A long random secret shared with the portal (its CUSTOMER_CONNECT_SECRET).
# Each paid order's customer then arrives at POST /api/ingest/checkout.
# CHECKOUT_PORTAL_SECRET=

# ── Optional ────────────────────────────────────────────────────────────────
# PORT=3000
# Signs unsubscribe links; defaults to JWT_SECRET. Never change it once emails have gone out.
# UNSUBSCRIBE_SECRET=
# DEFAULT_BRAND_COLOR=#1a5632
# How often the sender checks for due campaigns, in ms.
# WORKER_POLL_MS=10000
# Every new email's domain is checked for mail servers (DNS) before saving.
# Set to off only if this server can't do DNS lookups.
# EMAIL_DOMAIN_CHECK=off
# Run this instance without sending or syncing (e.g. a second web-only instance).
# DISABLE_WORKER=true
# PGSSLMODE=disable
